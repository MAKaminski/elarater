# Copy to .env.local for local development.
#
# Local dev points at the LOCAL Supabase stack — never point a dev client at prod
# (docs/02-architecture.md). Bring the stack up with `supabase start`, then read the
# anon key out of `supabase status`.
#
# Production values live ONLY in the Vercel project's environment variables, injected
# by the Supabase Marketplace integration. This repo is public; nothing real goes here.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-from-supabase-status

# Base URL used to build certificate permalinks and OG image URLs.
EXPO_PUBLIC_SITE_URL=http://localhost:8081
